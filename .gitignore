# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Node / TypeScript
node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/test-results/
apps/web/playwright-report/
*.tsbuildinfo

# Local data and runtime artifacts
artifacts/**
data/**/*.parquet
data/**/*.duckdb
data/**/*.db
# Runtime product/research state must not dirty the source worktree.
# M4 evidence remains authoritative in its own append-only store/bundles;
# Git cleanliness is reserved for source/methodology changes.
data/product/**
data/research/**
artifacts/screenshots/*
artifacts/debug/*
artifacts/reports/*
artifacts/prospective/*
logs/*

# Keep directory placeholders
!data/.gitkeep
!artifacts/screenshots/.gitkeep
!artifacts/debug/.gitkeep
!artifacts/reports/.gitkeep
!logs/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example
