{
  "schema": 1,
  "policy": "exact_path_exact_rule_only",
  "wildcard_exceptions_allowed": false,
  "new_exception_requires_change_record": true,
  "categories": {
    "BLE001": {
      "rationale": "Existing orchestration/provider/evidence boundaries deliberately convert unpredictable third-party, filesystem, process or provider failures into structured fail-soft/fail-closed results. Narrowing exception classes is a behavior change and is outside M6.4 mechanical cleanup."
    },
    "TRY004": {
      "rationale": "Existing validators expose ValueError-like malformed-payload contracts. Changing exception type can alter callers/tests and is not a lint-only change."
    },
    "DTZ011": {
      "rationale": "Existing M1 operator scripts use date-only trading-calendar semantics. Timezone behavior must be changed only under an explicit data-semantic change, not repository-governance lint cleanup."
    },
    "DTZ001": {
      "rationale": "Legacy tests intentionally construct naive datetimes for existing contract fixtures; timezone migration requires a separate semantic change."
    },
    "S110": {
      "rationale": "Provider failover intentionally suppresses individual provider probe failures so fallback can proceed; the exact failover behavior is preserved."
    },
    "B008": {
      "rationale": "FastAPI Body(...) default declarations are framework dependency metadata; changing signature construction is an API-contract edit."
    },
    "B017": {
      "rationale": "Legacy negative-path model test asserts the broad failure contract; narrowing requires a test-contract review."
    },
    "RUF012": {
      "rationale": "Legacy test fixture uses a mutable class attribute intentionally as stub state; changing fixture lifecycle is not mechanical governance cleanup."
    }
  },
